            <span class="icon main__icon-selector icon--button click"
           style="background-image: url('/svg/main/selector.svg')"></span>
        </div>
    </nav>
  </aside>

 <header class="header">
    <div class="layout header__content text--small">
     <div class="header__search">
         <input type="text" placeholder="Search" class="text field field--header">
         <span class="icon header__icon-search icon--color-grey"  
         style="background-image: url('/svg/header/search.svg')"></span>

         <span class="icon icon--header-settings icon--button icon--color-blue click"
         style="background-image: url('/svg/header/settings.svg')"></span>      
     </div>

     <div class="header__buttons">
        <div class="button-1">
            <span class="icon icon--header-settings icon--button icon--color-yellow click"
           style="background-image: url('/svg/header/antena-signal.svg')"></span>  
        </div>

        <div class="button-2">
            <span class="icon icon--header-settings icon--button icon--color-symbols click"
           style="background-image: url('/svg/header/material-symbols.svg')"></span>  
        </div>

         <div class="button-3">
            <span class="icon icon--header-settings icon--button icon--color-yellow click"
           style="background-image: url('/svg/header/bell.svg')"></span>  
        </div>

     </div>
    </div>
 </header>
 <main class="main">
    <div class="layout">
        <section class="box analytic__block">
           <div class="analytic analytic--double analytic--blue">
            1 TEsT
                <span class="icon analityc__button icon--button icon--color-blue click"
                style="background-image: url('/svg/analytic/order.svg')"></span> 
             
                <div class="analytic__content vertical vertical--small">
                    <div class="analytic__title text text--light">$961</div>
                    <div class="analytic__description text">Total Order</div>
            </div>
                </div>
            <div class="analytic analytic--double analytic--purple"> 2 test</div>
            <div class="analytic analytic--blue"> 3 tost</div>
            <div class="analytic"> 4 tlus</div>
        </section>
    </div>
    </main>


